<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Consultar a GitHub si hay versiones nuevas y descargarlas. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Avisar de versiones nuevas (Android 13+ lo pide al usuario, bajo demanda). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Abrir el instalador de Android con la versión nueva (el usuario lo concede en Ajustes). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Alarmas a hora exacta. USE_EXACT_ALARM se concede al instalar (Android 13+); Play lo restringe,
         pero La Vara no se publica allí. En Android 12 se usa SCHEDULE_EXACT_ALARM. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <!-- Volver a programar las alarmas después de reiniciar el teléfono. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Pedir que el ahorro de batería no frene a La Vara (el usuario lo confirma). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Abrir otras apps cuando La Vara está en segundo plano (Android 10+ lo exige). El usuario lo
         concede en Ajustes ("Mostrar sobre otras apps"), solo si una automatización abre apps. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Acciones No molestar y modo silencio. El usuario lo concede en Ajustes ("Acceso a No molestar"),
         solo si una automatización lo usa. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Acción de brillo. El usuario lo concede en Ajustes ("Modificar ajustes del sistema"), solo si la usa. -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Acción "Enviar SMS". Se pide al agregar esa acción, nunca al instalar. Android 15 puede tratarlo
         como "configuración restringida" en apps instaladas desde un APK. -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- SEND_SMS haría que Android exija un teléfono con SIM; así La Vara sigue instalándose en tablets. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!-- Disparador por Bluetooth: saber qué aparato se conectó. Android 12+ lo pide al usuario
         ("Dispositivos cercanos") recién al elegir ese disparador; antes alcanzaba con BLUETOOTH. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <!-- Disparador por Wi-Fi: saber a qué red se conectó el teléfono. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Disparador por etiqueta NFC: leer y grabar etiquetas. Se concede al instalar; no hace falta que el
         teléfono tenga NFC para instalar La Vara. -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false" />

    <!-- Ver las apps que aparecen en el menú de apps, para elegir cuál abrir (Android 11+ lo exige). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Saber si hay un navegador para abrir enlaces. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!-- Disparador por ubicación: entrar o salir de una zona marcada en el mapa. La ubicación precisa se
         pide al elegir ese disparador; "todo el tiempo" (segundo plano) se concede en Ajustes. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Escuchar la batería y el cargador con la app cerrada: Android lo permite solo con un servicio
         visible ("La Vara está activa"). specialUse es el tipo para usos que no encajan en los otros. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:name=".LaVaraApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LaVara">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pantalla invisible que enciende la pantalla, pide desbloquear y abre la app o el enlace
             de una automatización. Tarea propia para no traer al frente la pantalla principal. -->
        <activity
            android:name=".system.device.UnlockAndOpenActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <receiver
            android:name=".system.alarm.AlarmReceiver"
            android:exported="false" />

        <!-- Fin de una espera larga ("Esperar 10 min"): la automatización sigue. -->
        <receiver
            android:name=".system.alarm.LaterReceiver"
            android:exported="false" />

        <!-- Disparador "Al llegar una notificación". Solo funciona si el usuario da "Acceso a notificaciones"
             en Ajustes; Android exige BIND_NOTIFICATION_LISTENER_SERVICE para conectarse. -->
        <service
            android:name=".system.notifications.NotificationWatchService"
            android:exported="true"
            android:label="@string/notification_watch_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Pantalla invisible que abre Android al acercar una etiqueta NFC grabada por La Vara. -->
        <activity
            android:name=".system.nfc.NfcTagActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:host="nfc"
                    android:scheme="lavara" />
            </intent-filter>
        </activity>

        <!-- Eventos protegidos del sistema: otras apps no pueden enviarlos. -->
        <receiver
            android:name=".system.alarm.SystemEventsReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".system.location.GeofenceReceiver"
            android:exported="false" />

        <!-- Accesibilidad: tocar botones solo dentro de las apps de la lista que el usuario elige en La Vara.
             Solo Android puede conectarse (BIND_ACCESSIBILITY_SERVICE). Apagado hasta que el usuario lo
             encienda en Ajustes → Accesibilidad. -->
        <service
            android:name=".system.accessibility.TapService"
            android:exported="true"
            android:label="@string/tap_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/tap_service" />
        </service>

        <!-- Android avisa si cada SMS enviado por una automatización salió o no. -->
        <receiver
            android:name=".system.device.SmsSentReceiver"
            android:exported="false" />

        <!-- Avisos protegidos del sistema (otras apps no pueden enviarlos). Llegan con La Vara cerrada. -->
        <receiver
            android:name=".system.connectivity.BluetoothReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".system.device.DeviceWatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Escuchar los avisos de batería y cargador para ejecutar las automatizaciones del usuario" />
        </service>

        <!-- Espera corta a que el usuario desbloquee el teléfono para ejecutar lo pendiente. Se apaga sola. -->
        <service
            android:name=".system.device.UnlockWaitService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Esperar a que el usuario desbloquee el teléfono para abrir lo que pidió una automatización" />
        </service>

        <!-- Widget de pantalla de inicio: un botón por automatización. -->
        <receiver
            android:name=".ui.widget.AutomationWidget"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_automation_info" />
        </receiver>

        <!-- Elegir qué automatización ejecuta el widget. La abre el launcher al agregarlo. -->
        <activity
            android:name=".ui.widget.WidgetConfigActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Pantalla invisible que ejecuta la automatización del widget. Al estar a la vista, Android deja
             abrir apps sin permisos extra. -->
        <activity
            android:name=".ui.widget.RunFromWidgetActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.archivos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/archivos" />
        </provider>
    </application>

</manifest>
